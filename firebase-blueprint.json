        "isEdited": { "type": "boolean" },
        "isAiGenerated": { "type": "boolean" }
      },
      "required": ["id", "channelId", "senderId", "senderName", "text", "timestamp"]
    },
    "CommunityJoinRequest": {
      "title": "CommunityJoinRequest",
      "description": "Pending member join requests for private channels",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "channelId": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userEmail": { "type": "string" },
        "requestedAt": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "channelId", "userId", "status"]
    },
    "AiKnowledgeBase": {
      "title": "AiKnowledgeBase",
      "description": "Fundora custom knowledge articles and Q&A entries for AI assistant",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "category": { "type": "string" },
        "question": { "type": "string" },
        "answer": { "type": "string" },
        "keywords": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "question", "answer"]
    },
    "ScheduledMessage": {
      "title": "ScheduledMessage",
      "description": "Automated scheduled announcements and AI investment tips",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "channelId": { "type": "string" },
        "text": { "type": "string" },
        "sendAt": { "type": "string" },
        "interval": { "type": "string" },
        "isSent": { "type": "boolean" }
      },
      "required": ["id", "channelId", "text", "sendAt"]
    },
    "UserNotification": {
      "title": "UserNotification",
      "description": "User in-app notifications and event triggers",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string" },
        "date": { "type": "string" },
        "read": { "type": "boolean" }
      },
      "required": ["id", "userId", "title", "message", "date"]
    }

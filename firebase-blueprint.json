        "usdtBep20QrCode": { "type": "string" }
      },
      "required": ["id", "usdtTrc20Address", "usdtBep20Address"]
    },
    "Inquiry": {
      "title": "Inquiry",
      "description": "Real-time user inquiries submitted via the platform landing page",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "message": { "type": "string" },
        "timestamp": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "name", "email", "message", "timestamp", "status"]
    },
    "CommunityChannel": {
      "title": "CommunityChannel",
      "description": "Public and private investment community chat channels",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string" },
        "description": { "type": "string" },
        "icon": { "type": "string" },
        "memberCount": { "type": "number" },
        "inviteCode": { "type": "string" },
        "isLocked": { "type": "boolean" },
        "createdBy": { "type": "string" }
      },
      "required": ["id", "name", "type"]
    },
    "CommunityMessage": {
      "title": "CommunityMessage",
      "description": "Messages posted inside community channels and DMs",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "channelId": { "type": "string" },
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "senderEmail": { "type": "string" },
        "senderAvatar": { "type": "string" },
        "senderRole": { "type": "string" },
        "text": { "type": "string" },
        "timestamp": { "type": "string" },
        "replyToId": { "type": "string" },
        "voiceNoteUrl": { "type": "string" },
        "attachmentUrl": { "type": "string" },
        "attachmentType": { "type": "string" },

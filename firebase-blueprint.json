    },
    "ai_knowledge": {
      "schema": "AiKnowledgeBase",
      "description": "Custom AI assistant knowledge base"
    },
    "scheduled_messages": {
      "schema": "ScheduledMessage",
      "description": "Scheduled broadcasts and AI tips"
    },
    "notifications": {

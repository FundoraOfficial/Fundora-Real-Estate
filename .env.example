# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==========================================
# GMAIL / SMTP DIRECT CONFIGURATION (Direct Inbox Delivery via Nodemailer)
# ==========================================
GMAIL_USER="fundora.one@gmail.com"
GMAIL_PASS=""
SMTP_USER="fundora.one@gmail.com"
SMTP_PASS=""

# ==========================================
# OTP EMAIL CONFIGURATION (Required for Vercel Deployment to send Real OTPs)
# ==========================================

# OPTION A: RESEND API (Zero branding, free, highly recommended)
# Get a free API key at https://resend.com and add it to Vercel Environment Variables as RESEND_API_KEY.
# DO NOT commit real re_ keys to GitHub repo as GitHub will auto-detect and revoke them.
RESEND_API_KEY=""
VITE_RESEND_API_KEY=""

# Tell the frontend that real email is active
VITE_EMAIL_SERVICE_ACTIVE="true"

# The sender email. Must be no-reply@fundora.one (verified domain in Resend)
RESEND_FROM_EMAIL="no-reply@fundora.one"
VITE_RESEND_FROM_EMAIL="no-reply@fundora.one"

# OPTION B: EMAILJS (Fallback)
# Configure EmailJS at https://emailjs.com and add credentials here.
VITE_EMAILJS_SERVICE_ID=""
VITE_EMAILJS_TEMPLATE_ID=""
VITE_EMAILJS_PUBLIC_KEY=""

# OPTION C: SECURE PROXY WEBHOOK (Perfect for GitHub Pages)
# Deploy a 100% free, unbranded Google Apps Script or Cloudflare Worker to send emails.
# This prevents GitHub from scanning/revoking keys since all keys are stored safely on the proxy server.
VITE_SECURE_PROXY_URL=""

# ==========================================
# FIREBASE ADMIN SDK (Required for FCM Push Notifications)
# ==========================================
# Generate private key JSON from Firebase Console -> Project Settings -> Service Accounts
FIREBASE_SERVICE_ACCOUNT_JSON=""



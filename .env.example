# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==========================================
# SENDPULSE EMAIL CONFIGURATION (Required for Vercel Deployment to send Real OTPs)
# ==========================================
# SendPulse API Key (Get from SendPulse -> Account Settings -> API -> API Keys)
SENDPULSE_API_KEY=""
VITE_SENDPULSE_API_KEY=""

# Tell the frontend that real email is active
VITE_EMAIL_SERVICE_ACTIVE="true"

# The sender email. Must be no-reply@fundora.one (registered domain in SendPulse)
SENDPULSE_FROM_EMAIL="no-reply@fundora.one"
VITE_SENDPULSE_FROM_EMAIL="no-reply@fundora.one"

# ==========================================
# FIREBASE ADMIN SDK (Required for FCM Push Notifications)
# ==========================================
# Generate private key JSON from Firebase Console -> Project Settings -> Service Accounts
FIREBASE_SERVICE_ACCOUNT_JSON=""
